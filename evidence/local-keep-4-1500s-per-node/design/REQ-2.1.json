{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area (pinned notes and regular notes)"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        },
        {
          "role": "text",
          "name": "Sprint goals"
        },
        {
          "role": "text",
          "name": "Groceries"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ]
  },
  "files": [
    "frontend/src/index.html",
    "frontend/src/style.css",
    "frontend/src/app.js",
    "backend/server.js",
    "backend/data/db.json",
    ".arc/design/REQ-2.1.json"
  ],
  "notes": "REQ-2.1: the home page lists all available notes fetched from GET /api/notes, rendered as note cards. Pinned notes (pinned === true, seed note titled \"Sprint goals\") are shown in their own grid under the \"Pinned\" heading, separated from regular notes (pinned === false, seed note titled \"Groceries\") which appear under the \"Others\" heading. Accessible names (\"Pinned\", \"Others\", \"Sprint goals\", \"Groceries\") are copied verbatim from the spec and seed data lives in backend/data/db.json on every fresh start. Fix: load() now unwraps the { notes: [...] } response envelope into the client state array so the notes list actually renders (previously render() threw because state.notes was an object)."
}