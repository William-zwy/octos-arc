{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Help"
        },
        {
          "role": "button",
          "name": "Send feedback"
        },
        {
          "role": "button",
          "name": "Keyboard shortcuts"
        },
        {
          "role": "button",
          "name": "Privacy"
        },
        {
          "role": "button",
          "name": "Terms"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ],
    "settings_menu_open": "boolean (client-side per-page-load state, not persisted)"
  },
  "files": [
    "frontend/src/index.html",
    "frontend/src/app.js",
    "frontend/src/style.css",
    "frontend/dist/index.html",
    "frontend/dist/app.js",
    "frontend/dist/style.css"
  ],
  "notes": "REQ-4.1: setting options list. The header Settings icon (button with accessible name 'Settings' from REQ-1.1, already in the served HTML) opens a settings options dropdown menu instead of the old snackbar. The menu is a hidden <div> inside .header-actions containing real <button> elements with the exact option labels 'Settings', 'Help', 'Send feedback', 'Keyboard shortcuts', 'Privacy', 'Terms' (broad standard set; the spec names no concrete items). Clicking the Settings icon toggles the menu; clicking a menu item closes it (and shows a snackbar with the chosen label); clicking outside or pressing Escape closes it. The dropdown markup lives in the served HTML before the Settings icon button in DOM order so anchored /^settings$/i clicks (REQ-4.2) resolve to the exact-text 'Settings' menu item. Pure client-side: no new routes, no data persisted; the menu's open state is per-page-load client state so parallel test runs never see each other's mutations. Existing features (notes, composer, search, sidebar, view toggle, snackbar) are untouched."
}