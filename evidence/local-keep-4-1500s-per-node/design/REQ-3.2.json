{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "Work"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Work editable"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ]
  },
  "files": [
    "frontend/src/index.html",
    "frontend/src/app.js",
    "frontend/src/style.css",
    "frontend/dist/index.html",
    "frontend/dist/app.js",
    "frontend/dist/style.css",
    "backend/data/db.json"
  ],
  "notes": "REQ-3.2: search by keyword with highlight. The seed store gains a note titled 'Study schedule' (id seed-study-schedule, unpinned, content 'Weekly study plan for the semester.') so the keyword 'st' matches its title. Search is already client-side: typing into the Search textbox sets state.search and visibleInView() filters notes case-insensitively over title+content. New: renderGrid() splits the note title and content on the active query (case-insensitive, every occurrence) and wraps each hit in <mark class=\"search-highlight\">, so the matching text is highlighted in the results list; style.css styles mark.search-highlight with a yellow background. With no query the text renders unchanged, so all other views/tests are unaffected. No backend route changes; GET /api/notes already serves the seed. Highlighting only ever reflects the user's own query text (re-computed from state.search per render, never persisted), so no strict-mode duplication or state leakage across parallel test runs."
}