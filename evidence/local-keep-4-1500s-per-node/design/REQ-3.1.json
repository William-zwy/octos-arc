{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "Work"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Work editable"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ]
  },
  "files": [
    "frontend/src/index.html",
    "frontend/src/app.js",
    "frontend/src/style.css",
    "frontend/dist/index.html",
    "frontend/dist/app.js",
    "frontend/dist/style.css"
  ],
  "notes": "REQ-3.1: suggested search filters. A 'Suggested filters' panel with one chip per known label (Work, Reminders, Work editable — the accessible label names, copied verbatim from the label catalog) lives inside .header-search and is hidden by default; focusing the Search textbox shows it, blur/Escape hide it. Clicking a chip applies that label filter (state.labelFilter, the same mechanism as the sidebar label filters from REQ-2.7.1) so the notes list shows only matching notes; clicking the same chip again clears the filter. Selecting the 'Reminders' chip shows the 'Call dentist existing' note, which carries the 'Reminders' label in the seed. Pure client-side behavior: no backend route changes, no seed mutation; the existing search-by-text input (REQ-3.2) and sidebar filters keep working unchanged. mousedown on the panel is preventDefault'ed so clicking a chip does not blur the input before its click event lands."
}