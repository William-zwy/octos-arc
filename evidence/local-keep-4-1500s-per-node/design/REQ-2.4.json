{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area (pinned notes and regular notes)"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    },
    {
      "method": "POST",
      "path": "/api/notes",
      "serves": "create a note from the Take a note editor (title + content); returns 201 with the created note, 400 on invalid JSON body"
    },
    {
      "method": "GET",
      "path": "/api/notes/:id",
      "serves": "single note JSON"
    },
    {
      "method": "PATCH",
      "path": "/api/notes/:id",
      "serves": "update an existing note's title/content (persists the edited note when the editor closes); returns 200 with the updated note, 404 when the note does not exist, 400 on invalid JSON body"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        },
        {
          "role": "text",
          "name": "Project ideas"
        },
        {
          "role": "text",
          "name": "Initial editable content"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ]
  },
  "files": [
    "backend/data/db.json",
    "backend/server.js",
    "frontend/src/app.js",
    "frontend/src/index.html",
    "frontend/src/style.css"
  ],
  "notes": "REQ-2.4 reuses the REQ-2.2 composer-as-editor pattern: clicking a note card opens the editor (Title + Take a note content + Close), editing fills the fields, and closing the editor persists via PATCH /api/notes/:id. Backend PATCH already exists; this node adds the seed note 'Project ideas' (content 'Initial editable content') to the JSON store and makes the editor always persist (title + content) when an edit session is closed, then re-renders the list so the updated content is visible on the home page."
}