{
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "serves": "frontend/dist/index.html (home page)"
    },
    {
      "method": "GET",
      "path": "/style.css",
      "serves": "frontend/dist/style.css"
    },
    {
      "method": "GET",
      "path": "/app.js",
      "serves": "frontend/dist/app.js"
    },
    {
      "method": "GET",
      "path": "/api/notes",
      "serves": "note list JSON that feeds the home page notes area (pinned notes and regular notes)"
    },
    {
      "method": "GET",
      "path": "/api/health",
      "serves": "health check"
    },
    {
      "method": "POST",
      "path": "/api/notes",
      "serves": "create a note from the Take a note editor (title + content + optional pinned flag); returns 201 with the created note, 400 on invalid JSON body"
    }
  ],
  "pages": [
    {
      "path": "/",
      "elements": [
        {
          "role": "button",
          "name": "Main menu"
        },
        {
          "role": "textbox",
          "name": "Search"
        },
        {
          "role": "button",
          "name": "List view"
        },
        {
          "role": "button",
          "name": "Settings"
        },
        {
          "role": "button",
          "name": "Notes"
        },
        {
          "role": "button",
          "name": "Reminders"
        },
        {
          "role": "button",
          "name": "Archive"
        },
        {
          "role": "button",
          "name": "Trash"
        },
        {
          "role": "textbox",
          "name": "Take a note"
        },
        {
          "role": "textbox",
          "name": "Title"
        },
        {
          "role": "button",
          "name": "Pin"
        },
        {
          "role": "button",
          "name": "Close"
        },
        {
          "role": "heading",
          "name": "Pinned"
        },
        {
          "role": "heading",
          "name": "Others"
        }
      ]
    }
  ],
  "data_model": {
    "notes": [
      {
        "id": "string",
        "title": "string",
        "content": "string",
        "pinned": "boolean",
        "archived": "boolean",
        "deletedAt": "string|null",
        "reminder": "string|null",
        "labels": [
          "string"
        ],
        "color": "string|null",
        "createdAt": "string",
        "updatedAt": "string"
      }
    ]
  },
  "files": [
    "frontend/src/index.html",
    "frontend/src/app.js",
    "backend/server.js",
    "frontend/dist/index.html",
    "frontend/dist/app.js"
  ],
  "notes": "REQ-2.8.3: adds a Pin button to the expanded Take a note composer. state.composerPinned tracks the toggle; closeComposer() includes pinned: true in the POST /api/notes body when the pin button is active, so the created note is created in the pinned state and render() (which already splits pinned/others into the Pinned and Others sections) shows it under the Pinned heading. Backend POST /api/notes now accepts an optional pinned field (normalizeNote already models pinned as a boolean). Existing routes (REQ-1.1/2.1/2.2), the note-card Pin/Unpin actions, seed data and the edit flow are untouched."
}